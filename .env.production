APP_NAME="Villa Estela"
APP_ENV=production
APP_KEY=base64:iO7U4HCgfywlhkffn0+WLHuWa0x9nr6IbZ3rwwmsIPk=
APP_DEBUG=false
APP_URL=https://villa-estela.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============= NEON POSTGRESQL (FREE TIER) =============
# Instructions:
# 1. Sign up at https://neon.tech (free account)
# 2. Create a new project and database
# 3. Copy your connection string: postgresql://user:password@host/database
# 4. In Render Dashboard, add these env vars:
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# For Neon, use the connection pooler endpoint (recommended):
# DB_HOST=your-neon-host-pooler.neon.tech
# See: https://neon.tech/docs/connect/connect-from-any-app

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
MEMCACHED_HOST=127.0.0.1

# ============= XENDIT (PAYMENT GATEWAY) =============
# Sign up at https://xendit.co/
# Get your API key from Dashboard > Settings > API Keys
# Sandbox (test): https://dashboard.xendit.co/
# Production: Use same dashboard, toggle between test/live mode
XENDIT_API_KEY=xnd_live_xxxxxxxxxxxxx
XENDIT_WEBHOOK_VERIFICATION_TOKEN=xnd_whsec_xxxxxxxxxxxxx




REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============= EMAIL CONFIGURATION =============
# Replace with your email provider. Options:
# - Gmail App Password (recommended for development)
# - SendGrid (free tier: 100 emails/day)
# - Mailgun (free tier: 5000 emails/month)
# - Postmark (free trial)

# Resend Example (recommended for hosted environments):
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="Villa Estella"

# SendGrid Example:
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# MAIL_FROM_ADDRESS=noreply@villaestella.com
# MAIL_FROM_NAME="Villa Estella"

# Mailgun Example:
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=your-domain.mailgun.org
# MAILGUN_SECRET=your-mailgun-api-key
# MAIL_FROM_ADDRESS=noreply@villaestella.com
# MAIL_FROM_NAME="Villa Estella"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Villa Estella"
MIGRATE_ROUTE_TOKEN=password123