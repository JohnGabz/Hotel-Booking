APP_NAME="Villa Estella"
APP_ENV=production
APP_KEY=base64:iO7U4HCgfywlhkffn0+WLHuWa0x9nr6IbZ3rwwmsIPk=
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============= NEON POSTGRESQL (FREE TIER) =============
# Instructions:
# 1. Sign up at https://neon.tech (free account)
# 2. Create a new project and database
# 3. Copy your connection string: postgresql://user:password@host/database
# 4. In Render Dashboard, add these env vars:
DB_CONNECTION=pgsql
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=villa_estella
DB_USERNAME=your_neon_user
DB_PASSWORD=your_neon_password
DB_SSLMODE=require

# For Neon, use the connection pooler endpoint (recommended):
# DB_HOST=your-neon-host-pooler.neon.tech
# See: https://neon.tech/docs/connect/connect-from-any-app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============= EMAIL CONFIGURATION =============
# Replace with your email provider. Options:
# - Gmail App Password (recommended for development)
# - SendGrid (free tier: 100 emails/day)
# - Mailgun (free tier: 5000 emails/month)
# - Postmark (free trial)

# Gmail Example (requires 2FA + App Password):
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS=noreply@villaestella.com
MAIL_FROM_NAME="Villa Estella"

# SendGrid Example:
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# MAIL_FROM_ADDRESS=noreply@villaestella.com
# MAIL_FROM_NAME="Villa Estella"

# Mailgun Example:
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=your-domain.mailgun.org
# MAILGUN_SECRET=your-mailgun-api-key
# MAIL_FROM_ADDRESS=noreply@villaestella.com
# MAIL_FROM_NAME="Villa Estella"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Villa Estella"
